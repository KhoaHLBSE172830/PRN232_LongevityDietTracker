{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "meals-route": {
        "ClusterId": "diet-fasting-cluster",
        "Match": {
          "Path": "/api/meals/{**catch-all}"
        }
      },
      "fasting-route": {
        "ClusterId": "diet-fasting-cluster",
        "Match": {
          "Path": "/api/fasting/{**catch-all}"
        }
      },
      "fmd-route": {
        "ClusterId": "diet-fasting-cluster",
        "Match": {
          "Path": "/api/fmd/{**catch-all}"
        }
      },
      "nutrition-route": {
        "ClusterId": "diet-fasting-cluster",
        "Match": {
          "Path": "/api/nutrition/{**catch-all}"
        }
      },
      "consultation-route": {
        "ClusterId": "consultation-cluster",
        "Match": {
          "Path": "/api/consultations/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "diet-fasting-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "consultation-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}
